<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/num1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:text=""
        android:textAlignment="textEnd"
        android:textSize="48sp" />

    <TextView
        android:id="@+id/num2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:text="0.0"
        android:textAlignment="textEnd"
        android:textSize="64sp" />


    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stretchColumns="*"
        android:gravity="center"
        android:layout_margin="16dp">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btn_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:insetLeft="6dp"
                android:insetTop="5dp"
                android:insetRight="6dp"
                android:insetBottom="5dp"
                android:text="AC"
                android:textSize="24sp" />

            <Space
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Space
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btn_delete_soft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:insetLeft="6dp"
                android:insetTop="5dp"
                android:insetRight="6dp"
                android:insetBottom="5dp"
                android:text="C"
                android:textSize="24sp" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btn_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:insetLeft="6dp"
                android:insetTop="5dp"
                android:insetRight="6dp"
                android:insetBottom="5dp"
                android:onClick="digitPress"
                android:text="1"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btn_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:insetLeft="6dp"
                android:insetTop="5dp"
                android:insetRight="6dp"
                android:insetBottom="5dp"
                android:onClick="digitPress"
                android:text="2"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btn_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:insetLeft="6dp"
                android:insetTop="5dp"
                android:insetRight="6dp"
                android:insetBottom="5dp"
                android:onClick="digitPress"
                android:text="3"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btn_plus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:insetLeft="6dp"
                android:insetTop="5dp"
                android:insetRight="6dp"
                android:insetBottom="5dp"
                android:onClick="operationPress"
                android:text="+"
                android:textSize="24sp" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btn_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:insetLeft="6dp"
                android:insetTop="5dp"
                android:insetRight="6dp"
                android:insetBottom="5dp"
                android:onClick="digitPress"
                android:text="4"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btn_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:insetLeft="6dp"
                android:insetTop="5dp"
                android:insetRight="6dp"
                android:insetBottom="5dp"
                android:onClick="digitPress"
                android:text="5"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btn_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:insetLeft="6dp"
                android:insetTop="5dp"
                android:insetRight="6dp"
                android:insetBottom="5dp"
                android:onClick="digitPress"
                android:text="6"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btn_minus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:insetLeft="6dp"
                android:insetTop="5dp"
                android:insetRight="6dp"
                android:insetBottom="5dp"
                android:onClick="operationPress"
                android:text="-"
                android:textSize="24sp" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btn_7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:insetLeft="6dp"
                android:insetTop="5dp"
                android:insetRight="6dp"
                android:insetBottom="5dp"
                android:onClick="digitPress"
                android:text="7"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btn_8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:insetLeft="6dp"
                android:insetTop="5dp"
                android:insetRight="6dp"
                android:insetBottom="5dp"
                android:onClick="digitPress"
                android:text="8"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btn_9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:insetLeft="6dp"
                android:insetTop="5dp"
                android:insetRight="6dp"
                android:insetBottom="5dp"
                android:onClick="digitPress"
                android:text="9"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btn_mult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:insetLeft="6dp"
                android:insetTop="5dp"
                android:insetRight="6dp"
                android:insetBottom="5dp"
                android:onClick="operationPress"
                android:text="*"
                android:textSize="24sp" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btn_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:insetLeft="6dp"
                android:insetTop="5dp"
                android:insetRight="6dp"
                android:insetBottom="5dp"
                android:onClick="digitPress"
                android:text="0"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btn_point"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:insetLeft="6dp"
                android:insetTop="5dp"
                android:insetRight="6dp"
                android:insetBottom="5dp"
                android:onClick="digitPress"
                android:text="."
                android:textSize="24sp" />

            <Button
                android:id="@+id/btn_equal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:insetLeft="6dp"
                android:insetTop="5dp"
                android:insetRight="6dp"
                android:insetBottom="5dp"
                android:text="="
                android:textSize="24sp" />

            <Button
                android:id="@+id/btn_div"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:insetLeft="6dp"
                android:insetTop="5dp"
                android:insetRight="6dp"
                android:insetBottom="5dp"
                android:onClick="operationPress"
                android:text="/"
                android:textSize="24sp" />
        </TableRow>

    </TableLayout>

</LinearLayout>